# Free Neon Postgres connection string (Neon Marketplace integration on
# Vercel injects this automatically; for local dev, create a free project at
# https://neon.tech and paste its pooled connection string here).
DATABASE_URL=

# Optional: enables the AI advisor via Gemini's free tier. Get a key at
# https://aistudio.google.com/apikey. Without this, the advisor still works
# using the built-in rule-based fallback (see src/lib/advisor-fallback.ts).
GOOGLE_GENERATIVE_AI_API_KEY=
