# Free Neon Postgres connection string (Neon Marketplace integration on
# Vercel injects this automatically; for local dev, create a free project at
# https://neon.tech and paste its pooled connection string here).
DATABASE_URL=

# Optional: enables the AI advisor via Gemini's free tier. Get a key at
# https://aistudio.google.com/apikey. Without this, the advisor still works
# using the built-in rule-based fallback (see src/lib/advisor-fallback.ts).
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: enables the "Request This Setup" confirmation email (with a PDF
# invoice attached) via Resend's free tier. Get a key at
# https://resend.com/api-keys. Without this, the request still saves to the
# database, it just skips sending an email.
RESEND_API_KEY=

# Optional: sender address for the confirmation email above. Defaults to
# Resend's shared test sender (onboarding@resend.dev), which works with no
# setup. Only needed once you verify your own sending domain in Resend.
RESEND_FROM_EMAIL=
